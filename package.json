{
  "name": "dsh-token-usage-observer",
  "version": "0.1.0",
  "description": "Collect and summarize local token usage from DeepSeek Harness, Codex and OpenCode logs.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "usage-stats",
    "codex",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhengDaoWang/dsh-token-usage-observer.git"
  },
  "bugs": {
    "url": "https://github.com/ZhengDaoWang/dsh-token-usage-observer/issues"
  },
  "homepage": "https://github.com/ZhengDaoWang/dsh-token-usage-observer",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}